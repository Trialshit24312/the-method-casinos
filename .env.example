# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
ADMIN_DISCORD_IDS=

# OAuth — must match Discord Developer Portal redirect URI exactly
# Local: http://localhost:3847/auth/discord/callback
# Production: https://YOUR-API.onrender.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3847/auth/discord/callback

# Public URLs (no trailing slash)
# Dashboard frontend when split from API (e.g. Cloudflare Pages)
PUBLIC_SITE_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
# Backend API URL when frontend is hosted separately
API_URL=http://localhost:3847

# Discord server invite (shown in dashboard footer and /website command)
DISCORD_INVITE_URL=https://discord.gg/your-invite

# Server
PORT=3847
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Discord webhook — discovery complete notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Free AI agents (pick ONE — no credit card)
# GEMINI_API_KEY=          # https://aistudio.google.com/apikey
# GROQ_API_KEY=            # https://console.groq.com/keys

# Optional: LangSmith tracing (Python agents — see agents/README.md)
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=The Method Casinos
# ANTHROPIC_API_KEY=       # not used — free Gemini/Groq instead (agents/)

# Optional: reliable discovery search (recommended for production)
# Get a key at https://serper.dev — falls back to DuckDuckGo/Bing HTML if unset
# SERPER_API_KEY=

# Optional background jobs (server must stay running — e.g. Render web service)
# REVALIDATE_INTERVAL_HOURS=12
# REVALIDATE_BATCH_SIZE=8
# DISCOVERY_SCHEDULE_HOURS=168
# DISCOVERY_SCHEDULE_DEEP=false
# DB_BACKUP_INTERVAL_HOURS=24

# --- Dashboard build-time (dashboard/.env or root for Vite loadEnv) ---
# VITE_API_URL=http://localhost:3847
# VITE_PUBLIC_SITE_URL=http://localhost:5173
# VITE_DISCORD_INVITE=https://discord.gg/your-invite
