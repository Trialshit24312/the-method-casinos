# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
ADMIN_DISCORD_IDS=

# OAuth — must match Discord Developer Portal redirect URI exactly
# Local: http://localhost:3847/auth/discord/callback
# Production: https://YOUR-API.onrender.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3847/auth/discord/callback

# Public URLs (no trailing slash)
# Dashboard frontend when split from API (e.g. Cloudflare Pages)
PUBLIC_SITE_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
# Backend API URL when frontend is hosted separately
API_URL=http://localhost:3847

# Discord server invite (shown in dashboard footer and /website command)
DISCORD_INVITE_URL=https://discord.gg/your-invite

# Server
PORT=3847
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: discovery search (if used)
# SERPER_API_KEY=

# --- Dashboard build-time (dashboard/.env or root for Vite loadEnv) ---
# VITE_API_URL=http://localhost:3847
# VITE_PUBLIC_SITE_URL=http://localhost:5173
# VITE_DISCORD_INVITE=https://discord.gg/your-invite
