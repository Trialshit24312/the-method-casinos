# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
ADMIN_DISCORD_IDS=

# OAuth — must match Discord Developer Portal redirect URI exactly
# Local (Vite proxy): http://localhost:5173/auth/discord/callback
# Production: https://YOUR-SERVICE.onrender.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# Public URLs (no trailing slash)
PUBLIC_SITE_URL=http://localhost:5173
DASHBOARD_URL=http://localhost:5173
API_URL=http://localhost:3847

# Discord server invite (shown in dashboard footer and /website command)
DISCORD_INVITE_URL=https://discord.gg/your-invite

# Server
PORT=3847
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Discord webhook — discovery complete, reports, deploy alerts
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# GitHub Actions only (repo secret): DISCORD_UPDATES_WEBHOOK_URL

# Live feed — mirror dashboard discovery log (dedicated webhook or bot channel)
# DISCORD_LIVE_FEED=1
# DISCORD_LIVE_FEED_WEBHOOK_URL=https://discord.com/api/webhooks/.../...  # "Live Feed" channel webhook
# DISCORD_FEED_CHANNEL_ID=1234567890123456789  # optional; bot posts + pinned embed (needs Manage Messages)
# DISCORD_LIVE_FEED_PIN=1
# DISCORD_LIVE_FEED_VERBOSE=0

# ── 100% FREE — no paid API keys required ──
# Discovery & similar-casino web search use DuckDuckGo Lite, DDG HTML, Bing, Brave.
# Do NOT set SERPER_API_KEY, GROQ_API_KEY, or GEMINI_API_KEY unless you opt in later.

# Render FREE tier — no disk; sync SQLite to Cloudflare R2 (see DEPLOYMENT.md)
# REMOTE_DB_SYNC=1
# S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# S3_BUCKET=method-casinos-db
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_OBJECT_KEY=casinos.db
# REMOTE_DB_SYNC_INTERVAL_MINUTES=3
# REMOTE_DB_SYNC_DEBOUNCE_SEC=8

# Optional local / paid Render disk
# DATA_DIR=/var/data

# Optional background jobs (server must stay running — e.g. Render web service)
# REVALIDATE_INTERVAL_HOURS=168
# REVALIDATE_BATCH_SIZE=8
# DISCOVERY_SCHEDULE_HOURS=168
# DISCOVERY_SCHEDULE_DEEP=false
# Discovery: crawl known list sites (SweepsKings, PlayUSA, etc.) — default on
# DISCOVERY_LIST_SITES=1
# DISCOVERY_LIST_SITE_URLS=https://example.com/my-sweepstakes-list
# Optional web search (off by default — list sites find casinos directly)
# DISCOVERY_WEB_SEARCH=1

# 24/7 server deep scans (Render web service must stay up; no browser tab needed)
# DISCOVERY_CONTINUOUS=1
# DISCOVERY_CONTINUOUS_COOLDOWN_SEC=90
# DISCOVERY_CONTINUOUS_BOOT_DELAY_SEC=45
# DB_BACKUP_INTERVAL_HOURS=24

# --- Dashboard build-time (dashboard/.env or root for Vite loadEnv) ---
# VITE_API_URL=http://localhost:3847
# VITE_PUBLIC_SITE_URL=http://localhost:5173
# VITE_DISCORD_INVITE=https://discord.gg/your-invite
