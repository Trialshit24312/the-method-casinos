{
  "name": "the-method-casinos",
  "version": "1.0.0",
  "description": "Discord bot + local dashboard for discovering free sweepstakes casinos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:dashboard\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:dashboard": "npm run dev --prefix dashboard",
    "build": "npm run build:dashboard && tsc",
    "build:all": "npm run build:dashboard && tsc",
    "build:dashboard": "npm run build --prefix dashboard",
    "render-build": "npm ci --include=dev && npm ci --include=dev --prefix dashboard && npm run build:all",
    "start": "node dist/index.js",
    "start:prod": "node dist/index.js",
    "register-commands": "tsx src/bot/register-commands.ts",
    "reset-data": "tsx src/scripts/reset-data.ts",
    "backup-db": "tsx src/scripts/backup-db.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "nanoid": "^5.0.9",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
